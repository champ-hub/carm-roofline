easyblock = 'PythonBundle'

name = 'carm-roofline'
version = '1.4.0'

homepage = 'https://github.com/champ-hub/carm-roofline'

description = '''
The CARM Tool - benchmark, visualize and profile Intel, AMD, ARM, RISC-V CPUs
with the Cache-Aware Roofline Model
'''

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}

builddependencies = [
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('matplotlib', '3.10.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('plotly.py', '6.5.0'),
    ('Flask', '3.1.1'),
    ('pydantic', '2.11.9'),
    ('PAPI', '7.2.0'),
]

