    ),
    (
        "dash",
        "4.4.1",
        {
            "checksums": ["9356ca7856bc496c12c5b6de5978aaf783e090d07450ee395ade1c0c2cbdf816"],
            "preinstallopts": "pip install --no-build-isolation --ignore-installed --prefix=%(installdir)s 'flask>=3.1' 'pydantic>=2' 'comm>=0.2' 'janus>=1.0' 'nest-asyncio>=1.6' 'retrying>=1.3' 'importlib-metadata' 'requests' && ",
