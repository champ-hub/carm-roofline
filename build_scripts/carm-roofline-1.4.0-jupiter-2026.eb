easyblock = "PythonBundle"

name = "carm-roofline"
version = "1.4.0"
versionsuffix = "-jupiter-2026"

homepage = "https://github.com/champ-hub/carm-roofline"

description = """
The CARM Tool - benchmark, visualize and profile Intel, AMD, ARM, RISC-V CPUs
with the Cache-Aware Roofline Model
"""

from easybuild.tools.systemtools import get_cpu_architecture as local_get_cpu_architecture

if local_get_cpu_architecture() != "AArch64":
    raise RuntimeError("This recipe targets Jupiter's AArch64 nodes")

toolchain = SYSTEM
dependencies = [
    ("Python/3.13.5", EXTERNAL_MODULE),
]

use_pip = True
sanity_pip_check = True
check_readelf_rpath = False
exts_default_options = {
    "use_pip_for_deps": True,
    "download_dep_fail": False,
}
modluafooter = 'depends_on("Python/3.13.5")'

exts_list = [
    (
        "matplotlib",
        "3.10.5",
        {
            "source_tmpl": "matplotlib-%(version)s-cp313-cp313-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
            "checksums": ["ee7a09ae2f4676276f5a65bd9f2bd91b4f9fbaedf49f40267ce3f9b448de501f"],
        },
    ),
    (
        "platformdirs",
        "4.3.7",
        {
            "source_tmpl": "platformdirs-%(version)s-py3-none-any.whl",
            "checksums": ["a03875334331946f13c549dbd8f4bac7a13a50a895a0eb1e8c6a8ace80d40a94"],
        },
    ),
    (
        "pandas",
        "2.3.3",
        {
            "source_tmpl": "pandas-%(version)s-cp313-cp313-manylinux_2_24_aarch64.manylinux_2_28_aarch64.whl",
            "checksums": ["e32e7cc9af0f1cc15548288a51a3b681cc2a219faa838e995f7dc53dbab1062d"],
        },
    ),
    (
        "rich",
        "14.3.2",
        {
            "checksums": ["e712f11c1a562a11843306f5ed999475f09ac31ffb64281f73ab29ffdda8b3b8"],
            "preinstallopts": "pip install --no-build-isolation --ignore-installed --prefix=%(installdir)s 'poetry-core>=1.9.0' 'hatchling>=1.11.0' 'flit_core>=3.12,<4' 'hatch-vcs>=0.4' && ",
            "download_dep_fail": False,
        },
    ),
    (
        "rich-argparse",
        "1.8.0",
        {
            "source_tmpl": "rich_argparse-%(version)s.tar.gz",
            "use_pip_for_deps": False,
        },
    ),
    (
        "tomli",
        "2.4.1",
        {
            "checksums": ["7c7e1a961a0b2f2472c1ac5b69affa0ae1132c39adcb67aba98568702b9cc23f"],
            "download_dep_fail": False,
            "preinstallopts": "pip install --no-build-isolation --ignore-installed --prefix=%(installdir)s 'flit_core>=3.8' && ",
        },
    ),
    (
        "argcomplete",
        "3.7.0",
        {
            "checksums": ["afde224f753f874807b1dc1414e883ab8fe0cda9c04807b6047dcb8e1ac23913"],
            "preinstallopts": "export PYTHONPATH=%(installdir)s/lib/python3.13/site-packages:$PYTHONPATH && ",
