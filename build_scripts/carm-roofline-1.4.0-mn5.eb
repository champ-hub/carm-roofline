easyblock = "PythonBundle"

name = "carm-roofline"
version = "1.4.0"
versionsuffix = "-mn5-py39"

homepage = "https://github.com/champ-hub/carm-roofline"

description = """
The CARM Tool - benchmark, visualize and profile Intel, AMD, ARM, RISC-V CPUs
with the Cache-Aware Roofline Model
"""

toolchain = SYSTEM
# The companion metadata maps the lowercase Python module to EasyBuild's Python.
dependencies = [
    ("hdf5/1.14.1-2-gcc", EXTERNAL_MODULE),
    ("mkl/2023.2.0", EXTERNAL_MODULE),
    ("impi/2021.10.0", EXTERNAL_MODULE),
    ("python/3.9.16-gcc", EXTERNAL_MODULE),
]

# Ignore user-site packages. They can conflict with this isolated application module.
modluafooter = '''
setenv("PYTHONNOUSERSITE", "1")
depends_on("hdf5/1.14.1-2-gcc")
depends_on("mkl/2023.2.0")
depends_on("impi/2021.10.0")
depends_on("python/3.9.16-gcc")
'''

use_pip = True
sanity_pip_check = True

exts_default_options = {
    "use_pip_for_deps": True,
    "download_dep_fail": True,
}

