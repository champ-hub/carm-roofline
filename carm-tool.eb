easyblock = 'PythonPackage'

name = 'carm-roofline'
version = '1.0.0-dev'

homepage = 'https://github.com/champ-hub/carm-roofline'
description = """CARM roofline benchmarking tool"""

toolchain = {'name': 'GCC', 'version': 'system'}

sources = ['%(namelower)s-%(version)s.tar.gz']
use_pip = True
pip_install_extra_args = '.[gui]'

moduleclass = 'tools'

sanity_check_paths = {
    'files': [],
    'dirs': [],
}

sanity_check_commands = [
    'carm --help',
    'python -c "import gui.dashboard"',
]
